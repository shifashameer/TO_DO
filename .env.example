# Copy to .env, then enter your PostgreSQL password. Never commit .env.
# For an existing volume, use its existing credentials; changing this does not reset them.
POSTGRES_USER=todo_user
POSTGRES_PASSWORD=REPLACE_WITH_YOUR_DATABASE_PASSWORD
POSTGRES_DB=todo_db
POSTGRES_PORT=5432
DATABASE_URL='host=127.0.0.1 user=todo_user dbname=todo_db port=5432 sslmode=disable connect_timeout=5'
TEST_DATABASE_URL='host=127.0.0.1 user=todo_test_user dbname=todo_test port=5433 sslmode=disable connect_timeout=5'
ADDR=127.0.0.1:8080
COOKIE_SECURE=false
# Export PGPASSWORD="$POSTGRES_PASSWORD" after sourcing this file.
# Set COOKIE_SECURE=true when serving over HTTPS.
